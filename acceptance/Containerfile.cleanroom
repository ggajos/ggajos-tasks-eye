FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json .npmrc ./

# Assertion A: the dependency tree resolves without running any install
# scripts. This isolates "the lockfile resolves" from "install-time binary
# downloads succeed", which fail independently under a network-restricted
# reviewer sandbox (see .plan/obsidian-submission-clean-install.md).
RUN npm ci --ignore-scripts --no-audit --no-fund

# Assertion B: a full install, including install scripts, also succeeds.
RUN rm -rf node_modules && npm ci --no-audit --no-fund

COPY . .
RUN node esbuild.config.mjs production
